{
	"name": "aqua-note",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:wrangler": "wrangler dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo 'svelte-kit sync skipped' && husky || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"pretest": "npm run format && npm run lint && npm run check",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply aqua-note-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply aqua-note-db --remote",
		"db:migrate:preview": "wrangler d1 migrations apply aqua_note_db --env preview --remote",
		"db:studio": "drizzle-kit studio",
		"db:reset:local": "wrangler d1 execute aqua-note-db --local --file=scripts/reset-db.sql && npm run db:migrate:local",
		"db:reset:remote": "wrangler d1 execute aqua-note-db --remote --file=scripts/reset-db.sql && npm run db:migrate:remote",
		"db:reset:preview": "wrangler d1 execute aqua-note-preview-db --remote --file=scripts/reset-db.sql && npm run db:migrate:preview",
		"deploy:preview": "wrangler deploy --env preview",
		"deploy:production": "wrangler deploy --env production",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@cloudflare/workers-types": "^4.20260207.0",
		"@inlang/paraglide-js": "^2.10.0",
		"@libsql/client": "^0.17.0",
		"@node-rs/argon2": "^2.0.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"drizzle-orm": "^0.45.1"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.0.1",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.35.0",
		"@internationalized/date": "^3.11.0",
		"@lucide/svelte": "^0.563.1",
		"@playwright/test": "^1.58.2",
		"@storybook/addon-a11y": "^10.2.8",
		"@storybook/addon-docs": "^10.2.8",
		"@storybook/addon-svelte-csf": "^5.0.10",
		"@storybook/addon-vitest": "^10.2.8",
		"@storybook/sveltekit": "^10.2.8",
		"@sveltejs/adapter-cloudflare": "^7.2.6",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^25",
		"@vitest/browser": "^4.0.18",
		"@vitest/browser-playwright": "^4.0.18",
		"@vitest/coverage-v8": "^4.0.18",
		"bits-ui": "^2.11.7",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.9",
		"eslint": "^9.35.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.2.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"mdsvex": "^0.12.6",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"storybook": "^10.2.8",
		"svelte": "^5.50.0",
		"svelte-check": "^4.3.6",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.55.0",
		"vite": "^7.3.1",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2",
		"wrangler": "^4.63.0"
	}
}
